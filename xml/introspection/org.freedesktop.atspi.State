<interface name="org.freedesktop.atspi.StateSet">
  <method name="contains">
    <arg direction="in" name="state" type="u"/>
    <arg direction="out" type="b"/>
  </method>
  <method name="add">
    <arg direction="in" name="state" type="u"/>
  </method>
  <method name="remove">
    <arg direction="in" name="state" type="u"/>
  </method>
  <method name="equals">
    <arg direction="in" name="tarStateSet" type="o"/>
    <arg direction="out" type="b"/>
  </method>
  <method name="compare">
    <arg direction="in" name="compareState" type="o"/>
    <arg direction="out" type="o"/>
  </method>
  <method name="isEmpty">
    <arg direction="out" type="b"/>
  </method>
  <method name="getStates">
    <arg direction="out" type="au"/>
  </method>
</interface>
