From: =?utf-8?q?Jeremy_B=C3=ADcha?= <jeremy.bicha@canonical.com>
Date: Wed, 28 Feb 2024 10:06:07 -0500
Subject: Drop unused xkbcommon dependency

no longer needed after 85166737e11e6e7cfe2cdf0f66b2dcf6f0a89c33

Forwarded: https://gitlab.gnome.org/GNOME/at-spi2-core/-/merge_requests/158
---
 atspi/meson.build | 2 +-
 meson.build       | 2 --
 2 files changed, 1 insertion(+), 3 deletions(-)

diff --git a/atspi/meson.build b/atspi/meson.build
index c14aeec..c89b0e4 100644
--- a/atspi/meson.build
+++ b/atspi/meson.build
@@ -99,7 +99,7 @@ atspi = library('atspi', atspi_sources + atspi_enums + atspi_marshals,
                        version: soversion,
                        soversion: soversion.split('.')[0],
                        include_directories: [ root_inc, registryd_inc ],
-                       dependencies: [ libdbus_dep, gobject_dep, gio_dep, dbind_dep, x11_deps, xkbcommon_dep ],
+                       dependencies: [ libdbus_dep, gobject_dep, gio_dep, dbind_dep, x11_deps, ],
                        install: true)
 
 atspi_dep = declare_dependency(link_with: atspi,
diff --git a/meson.build b/meson.build
index 4e8ad22..241f7da 100644
--- a/meson.build
+++ b/meson.build
@@ -128,11 +128,9 @@ gobject_req_version = '>= 2.0.0'
 gmodule_req_version = '>= 2.0.0'
 gio_req_version = '>= 2.28.0'
 libxml_req_version = '>= 2.9.1'
-xkbcommon_req_version = '>= 1.0.0'
 
 if not get_option('atk_only')
   libdbus_dep = dependency('dbus-1', version: libdbus_req_version)
-  xkbcommon_dep = dependency('xkbcommon', version: xkbcommon_req_version)
 endif
 
 glib_dep = dependency('glib-2.0', version: glib_req_version)
